{
  "$defs": {
    "AgentEntry": {
      "description": "One connected agent. Lives exactly as long as its wrapper's connection to\nthe daemon; nothing here is persisted.",
      "properties": {
        "agent": {
          "description": "Agent kind, e.g. `claude`. Free-form so that a wrapper built against a\nnewer agent list still registers against an older daemon.",
          "type": "string"
        },
        "agent_session_id": {
          "description": "Reported by integration hooks; absent when none are installed.",
          "type": [
            "string",
            "null"
          ]
        },
        "agent_session_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "description": "Argv of the wrapped agent, agent name included.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "id": {
          "description": "Generated by the wrapper at launch. Also handed to integration hooks as\n`AMON_AGENT_ID`.",
          "type": "string"
        },
        "pid": {
          "description": "Process id of the wrapped agent, not of the wrapper.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "started_at": {
          "description": "Unix milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "state_since": {
          "description": "When the agent last entered [`AgentEntry::state`], unix milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "description": "Terminal title the agent set, if any.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "agent",
        "state",
        "state_since",
        "cwd",
        "pid",
        "args",
        "hostname",
        "started_at"
      ],
      "type": "object"
    },
    "AgentPatch": {
      "description": "A partial update to an entry. Absent fields are left alone, which is what\nlets an old wrapper omit fields a newer daemon knows about.",
      "properties": {
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_session_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentState"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_since": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "description": "Two levels deep because \"clear the title\" has to be expressible: absent\nmeans leave alone, `null` means clear, a string means set. An older\ndaemon reads `null` as absent and merely keeps the stale title.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "AgentState": {
      "description": "The state of a wrapped agent, as arbitrated by its wrapper.\n\nThese are herdr's detection states; amon does not add to them.",
      "oneOf": [
        {
          "const": "idle",
          "description": "Finished, prompt visible, nothing happening.",
          "type": "string"
        },
        {
          "const": "working",
          "description": "Actively working.",
          "type": "string"
        },
        {
          "const": "blocked",
          "description": "Needs human input.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Running, but not recognized as an agent.",
          "type": "string"
        }
      ]
    },
    "Error": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "oneOf": [
        {
          "enum": [
            "invalid_params",
            "internal"
          ],
          "type": "string"
        },
        {
          "const": "invalid_frame",
          "description": "The frame was not a JSON object with an `id` and a `method`.",
          "type": "string"
        },
        {
          "const": "unsupported_method",
          "description": "A method this peer does not implement — including one from a newer amon.",
          "type": "string"
        },
        {
          "const": "unknown_agent",
          "description": "No registry entry with that id.",
          "type": "string"
        }
      ]
    },
    "Event": {
      "description": "Pushed by the daemon to every subscriber, unsolicited.\n\n[`Event::Unknown`] is what makes a subscriber built against an older amon\nsurvive a newer daemon: events it has never heard of land here and are\nskipped rather than breaking the stream.",
      "oneOf": [
        {
          "description": "An agent registered.",
          "properties": {
            "event": {
              "const": "agent_connected",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/AgentEntry"
            }
          },
          "required": [
            "event",
            "params"
          ],
          "type": "object"
        },
        {
          "description": "An agent's entry changed — state, title, or session identity.",
          "properties": {
            "event": {
              "const": "agent_updated",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/AgentEntry"
            }
          },
          "required": [
            "event",
            "params"
          ],
          "type": "object"
        },
        {
          "description": "An agent's wrapper disconnected; its entry is gone.",
          "properties": {
            "event": {
              "const": "agent_disconnected",
              "type": "string"
            },
            "params": {
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          },
          "required": [
            "event",
            "params"
          ],
          "type": "object"
        }
      ]
    },
    "Hello": {
      "properties": {
        "protocol": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "version": {
          "description": "Version of the amon binary on the connecting side.",
          "type": "string"
        }
      },
      "required": [
        "role",
        "protocol",
        "version"
      ],
      "type": "object"
    },
    "ReportSession": {
      "description": "A hook reporting session identity. Mirrors herdr's\n`pane.report_agent_session`.",
      "properties": {
        "agent": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "agent_session_id": {
          "type": "string"
        },
        "agent_session_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session_start_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "source",
        "agent",
        "seq",
        "agent_session_id"
      ],
      "type": "object"
    },
    "ReportState": {
      "description": "A hook reporting agent state. Field names mirror herdr's `pane.report_agent`\nso that vendored hook assets need only mechanical renaming.",
      "properties": {
        "agent": {
          "type": "string"
        },
        "agent_id": {
          "description": "The `AMON_AGENT_ID` the hook was given.",
          "type": "string"
        },
        "agent_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "description": "Monotonic per-source sequence number, used to drop out-of-order reports.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "description": "Which integration produced this, e.g. `amon:claude`.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        }
      },
      "required": [
        "agent_id",
        "source",
        "agent",
        "state",
        "seq"
      ],
      "type": "object"
    },
    "Request": {
      "description": "One request frame: `{\"id\": …, \"method\": …, \"params\": …}`.",
      "oneOf": [
        {
          "description": "Opens any connection to the daemon.",
          "properties": {
            "method": {
              "const": "hello",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/Hello"
            }
          },
          "required": [
            "method",
            "params"
          ],
          "type": "object"
        },
        {
          "description": "Wrapper claims a registry entry. The entry lives until this connection\ndrops.",
          "properties": {
            "method": {
              "const": "agent.register",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/AgentEntry"
            }
          },
          "required": [
            "method",
            "params"
          ],
          "type": "object"
        },
        {
          "description": "Wrapper reports a change to its own entry.",
          "properties": {
            "method": {
              "const": "agent.update",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/AgentPatch"
            }
          },
          "required": [
            "method",
            "params"
          ],
          "type": "object"
        },
        {
          "description": "Lists connected agents.",
          "properties": {
            "method": {
              "const": "status",
              "type": "string"
            }
          },
          "required": [
            "method"
          ],
          "type": "object"
        },
        {
          "description": "Turns this connection into an event stream.",
          "properties": {
            "method": {
              "const": "subscribe",
              "type": "string"
            }
          },
          "required": [
            "method"
          ],
          "type": "object"
        },
        {
          "description": "Asks an older daemon to exit so a newer binary can take over.",
          "properties": {
            "method": {
              "const": "daemon.shutdown",
              "type": "string"
            }
          },
          "required": [
            "method"
          ],
          "type": "object"
        },
        {
          "description": "Hook → wrapper.",
          "properties": {
            "method": {
              "const": "agent.report_state",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/ReportState"
            }
          },
          "required": [
            "method",
            "params"
          ],
          "type": "object"
        },
        {
          "description": "Hook → wrapper.",
          "properties": {
            "method": {
              "const": "agent.report_session",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/ReportSession"
            }
          },
          "required": [
            "method",
            "params"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Response": {
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "result": true
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Role": {
      "description": "What a peer is, declared in its [`Hello`].\n\nDeclarative, not load-bearing: what a connection can do is decided by the\nmethods it sends (`agent.register` claims an entry, `subscribe` starts the\nevent stream), so the daemon does not branch on this. It exists for\ndiagnostics and for future daemons that may want to.",
      "oneOf": [
        {
          "enum": [
            "wrapper",
            "subscriber",
            "client"
          ],
          "type": "string"
        },
        {
          "const": "hook",
          "description": "An installed integration hook, talking to a wrapper rather than the\ndaemon. Hooks do not actually send a hello — they send one request and\nhang up — but the role exists so their frames can be described.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The whole protocol in one document, so that non-Rust peers — the installed\nintegration hooks are shell and JavaScript — have something to validate\nagainst.",
  "properties": {
    "event": {
      "$ref": "#/$defs/Event"
    },
    "request": {
      "$ref": "#/$defs/Request"
    },
    "response": {
      "$ref": "#/$defs/Response"
    }
  },
  "required": [
    "request",
    "response",
    "event"
  ],
  "title": "Protocol",
  "type": "object"
}
